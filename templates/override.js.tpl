// Generated by clash.py. Edit rules/*.yaml, not this file.
// Clash Verge Rev / FlClash subscription extension script; no network requests or secrets.

const SCRIPT_VERSION = "1.1.0";
const CUSTOM_RULES = __CUSTOM_RULES_JSON__;
const AI_GROUP = "Ai+";
const AI_STABLE_GROUP = "Ai稳定选择";
const AI_AUTO_GROUP = "Ai测速备用";
const LEGACY_AI_AUTO_GROUP = "Ai自动选择";
const SCHOLAR_GROUP = "学术搜索";
const ACADEMIC_GROUP = "学术访问";
const FALLBACK_GROUP = "漏网之鱼";

// Health probe for Ai测速备用. The primary endpoint verifies the node can
// really reach OpenAI, so it also filters out nodes that are merely online
// but IP-banned by OpenAI. If the primary endpoint dies or gets tightened by
// Cloudflare, switch AI_PROBE_URL to the backup below — but the backup only
// proves generic connectivity and cannot detect OpenAI IP bans. Confirm an
// endpoint is actually reachable before changing any probe URL.
const AI_PROBE_URL = "https://chatgpt.com/cdn-cgi/trace";
const AI_PROBE_URL_BACKUP = "https://www.gstatic.com/generate_204";

// AI node selection is a positive whitelist: only US nodes enter the AI pool,
// because OpenAI and Anthropic geo-block most other regions. To widen the
// region set later (for example US + Japan), extend AI_INCLUDE_SOURCE — do
// NOT revert to an exclusion-style filter. Both observed naming styles must
// keep matching:
//   🇺🇸 美国-BGP-05【优化】
//   🇺🇸 Basic-美国-BGP-01|v202605
// The bounded us/usa tokens keep names like "Russia" or "Australia" from
// matching accidentally.
const AI_INCLUDE_SOURCE = "(?:🇺🇸|美国|美國|united[ -]?states|(?:^|[^a-z])(?:us|usa)(?:[^a-z]|$))";

// AI_EXCLUDE only strips informational nodes injected by airports
// (Expire/Traffic/Sync/官网/套餐/剩余流量...). Region filtering is
// AI_INCLUDE's job; a US-named node stays even if its name also contains
// region words such as 香港.
const AI_EXCLUDE_SOURCE = "(?:🇺🇳|剩余流量|流量剩余|到期时间|过期时间|重置时间|套餐提示|订阅信息|(?:^|[\\s|_-])(?:expire|traffic|sync|reset|官网|套餐|订阅|更新|客服|网址)(?:[\\s:：|_-]|$))";

const AI_INCLUDE = new RegExp(AI_INCLUDE_SOURCE, "i");
const AI_EXCLUDE = new RegExp(AI_EXCLUDE_SOURCE, "i");

// Mihomo (Go RE2) group filters have no /i flag; an inline (?i) group is
// required for the runtime filter written onto provider-mode groups.
const coreFilter = (source) => `(?i)${source}`;

// Built-in non-proxy node types that must never join an AI group.
const NON_PROXY_TYPES = new Set([
  "direct",
  "reject",
  "reject-drop",
  "pass",
  "pass-name",
  "compatible",
  "dns-out",
  "dns-in",
]);

function groupByName(config, name) {
  const groups = Array.isArray(config["proxy-groups"]) ? config["proxy-groups"] : [];
  return groups.find((group) => group && group.name === name);
}

function providerNames(config) {
  const providers = config["proxy-providers"];
  if (!providers || typeof providers !== "object" || Array.isArray(providers)) return [];
  return Object.keys(providers).filter((name) => typeof name === "string" && name);
}

function eligibleAiNodes(config) {
  if (!Array.isArray(config.proxies)) return [];
  const seen = new Set();
  return config.proxies
    .filter((proxy) => proxy && typeof proxy.name === "string" && proxy.name)
    .filter((proxy) => !NON_PROXY_TYPES.has(String(proxy.type || "").toLowerCase()))
    .map((proxy) => proxy.name)
    // Whitelist first: a node named like a US node stays even if its name
    // also contains region words (protects against airport rename mixups).
    .filter((name) => AI_INCLUDE.test(name) && !AI_EXCLUDE.test(name))
    .filter((name) => {
      if (seen.has(name)) return false;
      seen.add(name);
      return true;
    });
}

// Subscription-specific fix: some providers ship Apple and AppleDev
// rule-providers that share one cache path, which breaks Mihomo startup.
// This is a targeted correction for that particular subscription —
// re-evaluate it whenever the subscription changes.
function fixProviderPaths(config) {
  const providers = config["rule-providers"];
  if (!providers || typeof providers !== "object") return;
  const apple = providers.Apple;
  const appleDev = providers.AppleDev;
  if (apple && appleDev && apple.path && apple.path === appleDev.path) {
    apple.path = "./providers/rule/Apple.yaml";
  }
}

// Remove groups owned by this project so re-running the script stays
// idempotent. Group names listed here are this project's namespace.
function removeGeneratedGroups(config) {
  const generated = [
    AI_STABLE_GROUP,
    AI_AUTO_GROUP,
    LEGACY_AI_AUTO_GROUP,
    SCHOLAR_GROUP,
    ACADEMIC_GROUP,
  ];
  config["proxy-groups"] = config["proxy-groups"].filter(
    (group) => group && !generated.includes(group.name),
  );
}

function insertGroupsBeforeAi(config, groups) {
  const aiIndex = config["proxy-groups"].findIndex(
    (group) => group && group.name === AI_GROUP,
  );
  config["proxy-groups"].splice(aiIndex, 0, ...groups);
}

function configureInlineGroups(config, ai, nodes) {
  const aiStable = {
    name: AI_STABLE_GROUP,
    type: "select",
    proxies: [...nodes],
  };
  const aiAuto = {
    name: AI_AUTO_GROUP,
    type: "url-test",
    proxies: [...nodes],
    url: AI_PROBE_URL,
    interval: 300,
    tolerance: 50,
    lazy: true,
    timeout: 8000,
    "max-failed-times": 2,
    "expected-status": 200,
  };
  const scholar = {
    name: SCHOLAR_GROUP,
    type: "select",
    proxies: [AI_STABLE_GROUP, AI_AUTO_GROUP],
  };
  const academic = {
    name: ACADEMIC_GROUP,
    type: "select",
    proxies: ["DIRECT", AI_GROUP],
  };
  insertGroupsBeforeAi(config, [aiStable, aiAuto, scholar, academic]);

  // Explicit node lists avoid runtime compatibility problems in FlClash
  // versions that display newer dynamic fields but do not preserve them.
  ai.proxies = [AI_STABLE_GROUP, AI_AUTO_GROUP];
  for (const key of [
    "include-all",
    "include-all-proxies",
    "include-all-providers",
    "filter",
    "exclude-filter",
    "exclude-type",
    "default-selected",
    "empty-fallback",
  ]) delete ai[key];
}

function configureProviderGroups(config, ai, providers) {
  // proxy-providers subscription: node names cannot be enumerated at script
  // time, so Ai稳定选择/Ai测速备用 are NOT rebuilt. Instead Ai+ keeps its own
  // group and gets use+filter; the core resolves US nodes from the provider
  // at runtime.
  const scholar = {
    name: SCHOLAR_GROUP,
    type: "select",
    proxies: [AI_GROUP],
  };
  const academic = {
    name: ACADEMIC_GROUP,
    type: "select",
    proxies: ["DIRECT", AI_GROUP],
  };
  insertGroupsBeforeAi(config, [scholar, academic]);

  ai.use = [...providers];
  ai.filter = coreFilter(AI_INCLUDE_SOURCE);
  ai["exclude-filter"] = coreFilter(AI_EXCLUDE_SOURCE);
  for (const key of [
    "include-all",
    "include-all-proxies",
    "include-all-providers",
    "exclude-type",
    "default-selected",
    "empty-fallback",
  ]) delete ai[key];
}

// Returns the applied mode: "inline", "provider", or "degraded". Degrading
// (missing Ai+ / 漏网之鱼 / proxy-groups) records a warning and keeps going so
// rules are still applied; only a total lack of usable nodes throws.
function configureGroups(config, warnings) {
  if (!Array.isArray(config["proxy-groups"])) {
    warnings.push("subscription has no proxy-groups array; group configuration skipped, rules still applied");
    return "degraded";
  }

  const ai = groupByName(config, AI_GROUP);
  if (!ai) {
    warnings.push(`subscription is missing ${AI_GROUP}; group configuration skipped, rules still applied`);
    return "degraded";
  }

  const nodes = eligibleAiNodes(config);
  const providers = providerNames(config);
  let mode;
  if (nodes.length) {
    mode = "inline";
  } else if (providers.length) {
    mode = "provider";
  } else {
    throw new Error("subscription exposes neither usable inline proxies nor proxy-providers for AI nodes");
  }

  removeGeneratedGroups(config);
  if (mode === "inline") configureInlineGroups(config, ai, nodes);
  else configureProviderGroups(config, ai, providers);

  const fallback = groupByName(config, FALLBACK_GROUP);
  if (fallback) {
    const choices = Array.isArray(fallback.proxies) ? fallback.proxies : [];
    fallback.proxies = ["DIRECT", ...choices.filter((choice) => choice !== "DIRECT")];
    delete fallback["default-selected"];
  } else {
    warnings.push(`subscription is missing ${FALLBACK_GROUP}; fallback adjustment skipped`);
  }

  return mode;
}

function configureRules(config) {
  if (!Array.isArray(config.rules)) config.rules = [];
  const custom = new Set(CUSTOM_RULES);
  const customRuleKey = (rule) => {
    if (typeof rule !== "string") return null;
    const parts = rule.split(",").map((part) => part.trim());
    if (parts.length < 2 || ![
      "DOMAIN",
      "DOMAIN-SUFFIX",
      "DOMAIN-KEYWORD",
      "DOMAIN-WILDCARD",
      "DOMAIN-REGEX",
      "IP-CIDR",
      "IP-CIDR6",
      "SRC-IP-CIDR",
      "DST-PORT",
      "SRC-PORT",
      "PROCESS-NAME",
      "PROCESS-PATH",
      "NETWORK",
      "GEOIP",
      "GEOSITE",
    ].includes(parts[0].toUpperCase())) return null;
    const key = parts.slice(0, 2);
    if (parts[parts.length - 1] === "no-resolve") key.push("no-resolve");
    return key.join(",");
  };
  const customKeys = new Set(CUSTOM_RULES.map(customRuleKey));
  const original = config.rules.filter(
    (rule) => typeof rule !== "string" || !(
      custom.has(rule) ||
      rule.startsWith("RULE-SET,Custom-") ||
      customKeys.has(customRuleKey(rule))
    ),
  );
  config.rules = [...CUSTOM_RULES, ...original];
}

// Groups this run failed to produce are reported through warnings instead of
// throwing, so a partial subscription never cancels the rule override.
// In degraded mode no group was configured, so no group is validated either.
function validateResult(config, mode, warnings) {
  if (mode !== "degraded" && Array.isArray(config["proxy-groups"])) {
    const names = config["proxy-groups"].map((group) => group && group.name);
    if (names.some((name, index) => !name || names.indexOf(name) !== index)) {
      throw new Error("proxy group names must be present and unique");
    }

    if (mode === "inline") {
      for (const required of [
        AI_STABLE_GROUP,
        AI_AUTO_GROUP,
        SCHOLAR_GROUP,
        ACADEMIC_GROUP,
      ]) {
        if (!names.includes(required)) throw new Error(`generated group is missing: ${required}`);
      }
      if (!groupByName(config, AI_STABLE_GROUP).proxies.length ||
          !groupByName(config, AI_AUTO_GROUP).proxies.length) {
        throw new Error("AI stable/backup group is empty");
      }
      const expectedAiChoices = [AI_STABLE_GROUP, AI_AUTO_GROUP];
      if (JSON.stringify(groupByName(config, AI_GROUP).proxies) !==
          JSON.stringify(expectedAiChoices)) {
        throw new Error("Ai+ does not prefer stable selection");
      }
      if (JSON.stringify(groupByName(config, SCHOLAR_GROUP).proxies) !==
          JSON.stringify(expectedAiChoices)) {
        throw new Error("academic search does not share the stable AI exit");
      }
      if (JSON.stringify(groupByName(config, ACADEMIC_GROUP).proxies) !==
          JSON.stringify(["DIRECT", AI_GROUP])) {
        throw new Error("academic access does not prefer DIRECT with Ai+ backup");
      }
    } else if (mode === "provider") {
      const ai = groupByName(config, AI_GROUP);
      if (!Array.isArray(ai.use) || !ai.use.length || typeof ai.filter !== "string") {
        throw new Error("Ai+ provider filter is not configured");
      }
      if (JSON.stringify(groupByName(config, SCHOLAR_GROUP).proxies) !==
          JSON.stringify([AI_GROUP])) {
        throw new Error("academic search does not follow the provider-backed Ai+ exit");
      }
      if (JSON.stringify(groupByName(config, ACADEMIC_GROUP).proxies) !==
          JSON.stringify(["DIRECT", AI_GROUP])) {
        throw new Error("academic access does not prefer DIRECT with Ai+ backup");
      }
    }

    const fallback = groupByName(config, FALLBACK_GROUP);
    if (fallback && fallback.proxies[0] !== "DIRECT") {
      throw new Error("漏网之鱼 does not prefer DIRECT");
    }
  }

  if (config.rules.length < CUSTOM_RULES.length ||
      !CUSTOM_RULES.every((rule, index) => config.rules[index] === rule)) {
    throw new Error("custom rule priority is invalid");
  }
}

function main(config) {
  const original = config;
  const warnings = [];
  try {
    if (!config || typeof config !== "object") throw new Error("invalid subscription config");
    const next = JSON.parse(JSON.stringify(config));
    delete next.__flclashRules;
    fixProviderPaths(next);
    const mode = configureGroups(next, warnings);
    configureRules(next);
    validateResult(next, mode, warnings);
    // Visible application marker: check the subscription preview for
    // __flclashRules.applied to distinguish "override applied" (possibly
    // degraded, see warnings) from "override crashed and returned the
    // original config".
    next.__flclashRules = { applied: true, version: SCRIPT_VERSION, mode, warnings };
    return next;
  } catch (error) {
    if (typeof console !== "undefined" && typeof console.error === "function") {
      const detail = error && error.stack ? error.stack : `${error && error.message}`;
      console.error(`[FlClash rules] extension skipped: ${detail}`);
    }
    return original;
  }
}
